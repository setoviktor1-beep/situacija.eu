{
  "name": "situacija.eu",
  "version": "1.0.0",
  "description": "CRM and Gallery website for situacija.eu",
  "main": "server.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "schema:apply": "tsx directus/scripts/setup-schema.ts && tsx directus/scripts/setup-roles.ts && tsx directus/scripts/setup-flow.ts",
    "flow:apply": "tsx directus/scripts/setup-flow.ts",
    "roles:apply": "tsx directus/scripts/setup-roles.ts",
    "schema:verify": "tsx directus/scripts/verify-setup.ts",
    "schema:diff": "tsx directus/scripts/schema-diff.ts",
    "schema:snapshot": "tsx directus/scripts/schema-snapshot.ts",
    "seed": "tsx directus/scripts/seed.ts",
    "gen:types": "tsx directus/scripts/generate-types.ts",
    "content:build": "node scripts/extract-content.mjs && node scripts/generate-content.mjs && node scripts/extract-home.mjs && node scripts/generate-llms.mjs",
    "indexnow": "tsx scripts/indexnow.mts"
  },
  "dependencies": {
    "@directus/sdk": "^24.0.0",
    "@next/third-parties": "^16.3.1",
    "cheerio": "^1.1.2",
    "compression": "^1.8.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "leaflet": "^1.9.4",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "yaml": "^2.9.0"
  }
}
